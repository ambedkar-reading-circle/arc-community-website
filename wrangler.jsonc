{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arc-community-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": ["nodejs_compat"]
}
